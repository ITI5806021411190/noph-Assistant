{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/jigsaw",
      "destination": "/jigsaw/index.html"
    },
    {
      "source": "/jigsaw/",
      "destination": "/jigsaw/index.html"
    },
    {
      "source": "/remote",
      "destination": "/remote.html"
    },
    {
      "source": "/public",
      "destination": "/public.html"
    }
  ]
}
