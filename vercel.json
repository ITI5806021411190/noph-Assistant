{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/popular-vote", "destination": "/popular-vote/index.html" },
    { "source": "/popular-vote/", "destination": "/popular-vote/index.html" },
    { "source": "/popular-vote/stage", "destination": "/popular-vote/stage/index.html" },
    { "source": "/popular-vote/stage/", "destination": "/popular-vote/stage/index.html" },
    { "source": "/popular-vote/admin", "destination": "/popular-vote/admin/index.html" },
    { "source": "/popular-vote/admin/", "destination": "/popular-vote/admin/index.html" },
    { "source": "/jigsaw", "destination": "/jigsaw/index.html" },
    { "source": "/jigsaw/", "destination": "/jigsaw/index.html" },
    { "source": "/it-services/dashboard-builder", "destination": "/dashboard-builder.html" },
    { "source": "/it-services/dashboard-builder/:path*", "destination": "/dashboard-builder.html" },
    { "source": "/remote", "destination": "/remote.html" },
    { "source": "/public", "destination": "/public.html" }
  ]
}
