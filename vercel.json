{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/remote-live",
      "destination": "/remote-live.html"
    },
    {
      "source": "/remote",
      "destination": "/remote.html"
    },
    {
      "source": "/public",
      "destination": "/public.html"
    }
  ]
}
