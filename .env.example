DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSLMODE=require
HAOS_POSTGRES_PHASE1_ENABLED=false
HAOS_POSTGRES_AUTH_ENABLED=false
HAOS_POSTGRES_NOTIFICATIONS_ENABLED=false
HAOS_POSTGRES_STRICT=false
GAS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GAS_API_SECRET=replace-with-vercel-bridge-secret
