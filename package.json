{
  "name": "health-assistant-os",
  "version": "70.145.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.16.0",
    "firebase-tools": "^15.23.0"
  },
  "scripts": {
    "test:jigsaw:manager": "node --test tests/jigsaw/manager-source.test.mjs tests/jigsaw/object-only.test.mjs",
    "test:popular-vote:admin": "node --test tests/popular-vote/admin-manager.test.mjs tests/popular-vote/admin-source.test.mjs",
    "test:popular-vote:rules": "firebase emulators:exec --only firestore \"node tests/popular-vote/firestore-rules.test.mjs\"",
    "test:popular-vote:storage-rules": "firebase emulators:exec --only storage \"node tests/popular-vote/storage-rules.test.mjs\"",
    "test:popular-vote": "npm run test:popular-vote:admin && npm run test:popular-vote:rules && npm run test:popular-vote:storage-rules",
    "test:dashboard-builder": "node --test tests/dashboard-builder/dashboard-builder.test.mjs",
    "test:workspace-tab": "node --test tests/workspace-tab/workspace-tab.test.mjs",
    "test:schedule-tab-ui": "node --test tests/schedule-tab-ui/schedule-tab-ui.test.mjs",
    "test:it-booking": "node --test tests/it-booking/performance.test.mjs"
  }
}
